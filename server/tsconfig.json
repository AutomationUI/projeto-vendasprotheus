{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "src/**/*",
    "../src/types/governance.ts",
    "../src/types/decision-flows.ts",
    "../src/lib/commission-engine.ts",
    "../src/lib/data-scope.ts",
    "../src/lib/document-access.ts",
    "../src/lib/types-roles.ts",
    "../src/lib/mock-production.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
